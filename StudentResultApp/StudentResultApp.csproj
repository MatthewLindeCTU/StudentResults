    <UserSecretsId>72f5a08b-b045-440e-acc7-4b547ad4d20e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <None Include=".github\workflows\ci-cd.yml" />
  </ItemGroup>

  <ItemGroup>
