@page "/student-results"
@rendermode InteractiveServer
@using StudentResultApp.Models
@using StudentResultApp.Services
@inject StudentService StudentService
@inject StudentResultService StudentResultService

<div class="card shadow-sm mb-4">

    <div class="card-header bg-dark text-white">
        <h4 class="mb-0">Student Results Dashboard</h4>
    </div>

    <div class="card-body">

        <div class="card p-4 shadow-sm">

            <div class="row mb-3">

                <div class="col-md-6">
                    <label class="form-label">Student</label>
                    <select class="form-select" @bind="selectedStudentId">
                        <option value="0">-- Select Student --</option>
                        @foreach (var s in allStudents)
                        {
                            <option value="@s.StudentID">@s.FirstName @s.LastName</option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Module</label>
                    <input class="form-control" @bind="newResult.Module" />
                </div>

            </div>

            <div class="row mb-3">

                <div class="col-md-6">
                    <label class="form-label">Mark</label>
                    <input type="number" class="form-control" @bind="newResult.Mark" />
                </div>

            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <p class="text-danger">@errorMessage</p>
            }

            <button class="btn btn-primary" @onclick="AddResult">
                Save Student Result
            </button>

        </div>
    </div>
</div>

<br />

<table class="table table-bordered table-striped">

    <thead class="table-dark">
        <tr>
            <th>Full Name</th>
            <th>Module</th>
            <th>Mark</th>
            <th>Result</th>
        </tr>
    </thead>

    <tbody>
        @if (results.Count == 0)
        {
            <tr>
                <td colspan="4" class="text-center text-muted">
                    No student results captured yet.
                </td>
            </tr>
        }
        else
        {
            @foreach (var item in results)
            {
                <tr>
                    <td>@item.FirstName @item.LastName</td>
                    <td>@item.Module</td>
                    <td>@item.Mark</td>
                    <td>
                        @if (item.Mark >= 50)
                        {
                            <span class="badge bg-success">Pass</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Fail</span>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>

</table>

@code {

    private List<Student> allStudents = new();
    private List<StudentResult> results = new();
    private StudentResult newResult = new();
    private int selectedStudentId;
    private string? errorMessage;

    protected override void OnInitialized()
    {
        allStudents = StudentService.GetAll();
        results = StudentResultService.GetAll();
    }

    private void AddResult()
    {
        errorMessage = null;

        if (selectedStudentId == 0)
        {
            errorMessage = "Please select a student.";
            return;
        }

        newResult.StudentID = selectedStudentId;
        StudentResultService.Add(newResult);

        results = StudentResultService.GetAll();

        newResult = new StudentResult();
        selectedStudentId = 0;
    }
}